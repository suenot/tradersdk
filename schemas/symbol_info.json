{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SymbolInfo",
  "description": "Symbol trading information.",
  "type": "object",
  "required": [
    "base_asset",
    "max_leverage",
    "min_notional",
    "min_quantity",
    "price_precision",
    "quantity_precision",
    "quote_asset",
    "step_size",
    "symbol",
    "tick_size"
  ],
  "properties": {
    "base_asset": {
      "description": "Base asset (e.g., \"BTC\").",
      "type": "string"
    },
    "max_leverage": {
      "description": "Maximum allowed leverage.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "max_quantity": {
      "description": "Maximum order quantity.",
      "type": [
        "string",
        "null"
      ]
    },
    "min_notional": {
      "description": "Minimum notional value.",
      "type": "string"
    },
    "min_quantity": {
      "description": "Minimum order quantity.",
      "type": "string"
    },
    "price_precision": {
      "description": "Price decimal precision.",
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "quantity_precision": {
      "description": "Quantity decimal precision.",
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "quote_asset": {
      "description": "Quote asset (e.g., \"USDT\").",
      "type": "string"
    },
    "step_size": {
      "description": "Quantity step size.",
      "type": "string"
    },
    "symbol": {
      "description": "Trading symbol (e.g., \"BTCUSDT\").",
      "type": "string"
    },
    "tick_size": {
      "description": "Price tick size.",
      "type": "string"
    }
  }
}