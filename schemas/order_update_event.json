{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderUpdateEvent",
  "description": "Real-time order update event from exchange private WebSocket.\n\nContains both the exchange timestamp (when the exchange processed the order) and the local received timestamp for latency measurement.",
  "type": "object",
  "required": [
    "exchange",
    "exchange_timestamp",
    "filled_quantity",
    "order_id",
    "order_type",
    "price",
    "quantity",
    "received_at",
    "side",
    "status",
    "symbol"
  ],
  "properties": {
    "avg_fill_price": {
      "description": "Average fill price.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "client_order_id": {
      "description": "Client order ID (optional).",
      "type": [
        "string",
        "null"
      ]
    },
    "exchange": {
      "description": "Exchange name.",
      "type": "string"
    },
    "exchange_timestamp": {
      "description": "Exchange's order creation/transaction timestamp (ms).",
      "type": "integer",
      "format": "int64"
    },
    "fee": {
      "description": "Fee amount.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "fee_currency": {
      "description": "Fee currency.",
      "type": [
        "string",
        "null"
      ]
    },
    "filled_quantity": {
      "description": "Filled quantity.",
      "type": "number",
      "format": "double"
    },
    "order_id": {
      "description": "Order ID.",
      "type": "string"
    },
    "order_type": {
      "description": "Order type.",
      "allOf": [
        {
          "$ref": "#/definitions/OrderType"
        }
      ]
    },
    "price": {
      "description": "Order price.",
      "type": "number",
      "format": "double"
    },
    "quantity": {
      "description": "Order quantity.",
      "type": "number",
      "format": "double"
    },
    "raw": {
      "description": "Raw exchange response data."
    },
    "received_at": {
      "description": "Local timestamp when we received the update (ms).",
      "type": "integer",
      "format": "int64"
    },
    "side": {
      "description": "Order side.",
      "allOf": [
        {
          "$ref": "#/definitions/OrderSide"
        }
      ]
    },
    "status": {
      "description": "Order status.",
      "allOf": [
        {
          "$ref": "#/definitions/OrderStatus"
        }
      ]
    },
    "symbol": {
      "description": "Trading symbol.",
      "type": "string"
    }
  },
  "definitions": {
    "OrderSide": {
      "description": "Order side (buy/sell).",
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "OrderStatus": {
      "description": "Order status.",
      "oneOf": [
        {
          "description": "Order is created but not yet filled.",
          "type": "string",
          "enum": [
            "New"
          ]
        },
        {
          "description": "Order is partially filled.",
          "type": "string",
          "enum": [
            "PartiallyFilled"
          ]
        },
        {
          "description": "Order is fully filled.",
          "type": "string",
          "enum": [
            "Filled"
          ]
        },
        {
          "description": "Order was cancelled.",
          "type": "string",
          "enum": [
            "Cancelled"
          ]
        },
        {
          "description": "Order was rejected.",
          "type": "string",
          "enum": [
            "Rejected"
          ]
        },
        {
          "description": "Order expired.",
          "type": "string",
          "enum": [
            "Expired"
          ]
        }
      ]
    },
    "OrderType": {
      "description": "Order type.",
      "type": "string",
      "enum": [
        "Market",
        "Limit",
        "StopMarket",
        "StopLimit",
        "TakeProfitMarket",
        "TakeProfitLimit"
      ]
    }
  }
}